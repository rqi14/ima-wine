+/* Base relocations that fall in the shared section copies, for pre-relocating the copies.
+ * Only used when every such block is well formed: DIR64/HIGHLOW/ABSOLUTE entries that stay
+ * inside the copy. Otherwise NULL and the client relocates as usual.
+ * Keep the copy range rule in sync with the relocation skip in dlls/ntdll/unix/virtual.c */
+static IMAGE_BASE_RELOCATION *read_copy_relocs( int fd, const IMAGE_DATA_DIRECTORY *dir, size_t align_mask,
+                                                IMAGE_SECTION_HEADER *sec, unsigned int nb_sec, size_t *ret_size )
+{
+    IMAGE_BASE_RELOCATION *relocs = NULL, *rel, *end;
+    size_t map_size, file_size;
+    off_t read_pos;
+    unsigned int i;
+
+    if (!dir || !dir->Size) return NULL;
+    for (i = 0; i < nb_sec && !relocs; i++)
+    {
+        get_section_sizes( &sec[i], align_mask, &map_size, &read_pos, &file_size );
+        if (dir->VirtualAddress < sec[i].VirtualAddress ||
+            dir->VirtualAddress + dir->Size > sec[i].VirtualAddress + file_size) continue;
+        if (!(relocs = malloc( dir->Size ))) return NULL;
+        if (pread( fd, relocs, dir->Size, read_pos + dir->VirtualAddress - sec[i].VirtualAddress ) != dir->Size)
+        {
+            free( relocs );
+            return NULL;
+        }
+    }
+    if (!relocs) return NULL;
+
+    end = (IMAGE_BASE_RELOCATION *)((char *)relocs + dir->Size);
+    for (rel = relocs; rel + 1 <= end && rel->SizeOfBlock; rel = (IMAGE_BASE_RELOCATION *)((char *)rel + rel->SizeOfBlock))
+    {
+        USHORT *entry = (USHORT *)(rel + 1);
+        unsigned int count;
+        size_t range = 0;
+
+        if (rel->SizeOfBlock < sizeof(*rel) || (char *)rel + rel->SizeOfBlock > (char *)end) goto invalid;
+        for (i = 0; i < nb_sec; i++)
+        {
+            get_section_sizes( &sec[i], align_mask, &map_size, &read_pos, &file_size );
+            if (!is_shared_copy_section( &sec[i], read_pos, file_size )) continue;
+            if (rel->VirtualAddress < sec[i].VirtualAddress ||
+                rel->VirtualAddress >= sec[i].VirtualAddress + round_size( file_size, host_page_mask )) continue;
+            range = sec[i].VirtualAddress + round_size( file_size, host_page_mask ) - rel->VirtualAddress;
+            break;
+        }
+        if (!range) continue;  /* not in a copy: the client handles it */
+        for (count = (rel->SizeOfBlock - sizeof(*rel)) / sizeof(USHORT); count; count--, entry++)
+        {
+            USHORT offset = *entry & 0xfff;
+            switch (*entry >> 12)
+            {
+            case IMAGE_REL_BASED_ABSOLUTE: break;
+            case IMAGE_REL_BASED_HIGHLOW: if (offset + 4 > range) goto invalid; break;
+            case IMAGE_REL_BASED_DIR64: if (offset + 8 > range) goto invalid; break;
+            default: goto invalid;
+            }
+        }
+    }
+    *ret_size = dir->Size;
+    return relocs;
+
+invalid:
+    free( relocs );
+    return NULL;
+}
+
+/* apply the relocations that fall in the copies to the shared temp file */
+static int relocate_copies( int shared_fd, size_t copy_base, size_t copy_size, client_ptr_t delta,
+                            IMAGE_BASE_RELOCATION *relocs, size_t relocs_size, size_t align_mask,
+                            IMAGE_SECTION_HEADER *sec, unsigned int nb_sec )
+{
+    IMAGE_BASE_RELOCATION *rel, *end = (IMAGE_BASE_RELOCATION *)((char *)relocs + relocs_size);
+    size_t map_size, file_size, copy_off;
+    off_t read_pos;
+    unsigned int i;
+    char *copies;
+
+    copies = mmap( NULL, copy_size, PROT_READ | PROT_WRITE, MAP_SHARED, shared_fd, copy_base );
+    if (copies == MAP_FAILED) return 0;
+    for (rel = relocs; rel + 1 <= end && rel->SizeOfBlock; rel = (IMAGE_BASE_RELOCATION *)((char *)rel + rel->SizeOfBlock))
+    {
+        USHORT *entry = (USHORT *)(rel + 1);
+        unsigned int count;
+        char *page = NULL;
+
+        copy_off = 0;
+        for (i = 0; i < nb_sec; i++)
+        {
+            get_section_sizes( &sec[i], align_mask, &map_size, &read_pos, &file_size );
+            if (!is_shared_copy_section( &sec[i], read_pos, file_size )) continue;
+            if (rel->VirtualAddress >= sec[i].VirtualAddress &&
+                rel->VirtualAddress < sec[i].VirtualAddress + round_size( file_size, host_page_mask ))
+            {
+                page = copies + copy_off + rel->VirtualAddress - sec[i].VirtualAddress;
+                break;
+            }
+            copy_off += round_size( file_size, host_page_mask );
+        }
+        if (!page) continue;
+        for (count = (rel->SizeOfBlock - sizeof(*rel)) / sizeof(USHORT); count; count--, entry++)
+        {
+            USHORT offset = *entry & 0xfff;
+            if ((*entry >> 12) == IMAGE_REL_BASED_DIR64) *(INT64 *)(page + offset) += delta;
+            else if ((*entry >> 12) == IMAGE_REL_BASED_HIGHLOW) *(int *)(page + offset) += delta;
+        }
+    }
+    munmap( copies, copy_size );
+    return 1;
+}
